# Public hostname routed by Traefik
DOMAIN=atelier.example.com

# First-run PIN (4–12 digits, 6+ recommended). Only used while no PIN exists;
# change it afterwards from Paramètres → Sécurité.
INITIAL_PIN=

# Must match your Traefik setup
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Workshop time zone (today's sales, cash register, daily backups)
TZ=Europe/Paris

# Login duration on a device, in days
SESSION_DAYS=30
# Number of daily database snapshots kept in /data/backups
BACKUP_KEEP=14

# Photos are resized and re-encoded as WebP on upload (~200–400 KB each).
# Longest side in pixels, and WebP quality 1–100 (80 = visually lossless for photos)
PHOTO_MAX_PX=1920
PHOTO_QUALITY=80
